# ---- Monad mainnet (chain id 143) ----
MONAD_MAINNET_RPC=https://rpc.monad.xyz
MONAD_MAINNET_WSS=wss://rpc.monad.xyz
MONAD_CHAIN_ID=143

# ---- Deploy (fill only when deploying; keep this file out of git) ----
# Use a dedicated deployer key with only as much MON as needed. NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=
# Monadscan (Etherscan-style) API key for contract verification, if used.
MONADSCAN_API_KEY=

# For mainnet-fork testing:
# forge test --fork-url $MONAD_MAINNET_RPC
